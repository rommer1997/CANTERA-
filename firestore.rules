rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function owner(uid) { return signed() && request.auth.uid == uid; }
    function admin() { return signed() && request.auth.token.get('admin', false) == true; }
    function text(value, min, max) { return value is string && value.size() >= min && value.size() <= max; }
    function iso(value) {
      return value is string && value.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z');
    }
    function date(value) { return value is timestamp || iso(value); }
    function runtimeOpen() { return exists(/databases/$(database)/documents/communityConfiguration/runtime) && get(/databases/$(database)/documents/communityConfiguration/runtime).data.serviceStatus == 'open'; }
    function accountAllowed() { return !exists(/databases/$(database)/documents/communityAccountModeration/$(request.auth.uid)) || get(/databases/$(database)/documents/communityAccountModeration/$(request.auth.uid)).data.status != 'suspended'; }
    function actorProfile() { return get(/databases/$(database)/documents/communityProfiles/$(request.auth.uid)).data; }
    function active() {
      return signed() && runtimeOpen() && accountAllowed() && exists(/databases/$(database)/documents/communityProfiles/$(request.auth.uid))
        && completedProfile(actorProfile());
    }
    function hasPost(id) { return text(id, 1, 128) && exists(/databases/$(database)/documents/communityPosts/$(id)); }
    function verifiedActor() { return active() && request.auth.token.get('email_verified', false) == true; }
    function eventPublic(data) { return data.get('visibility', 'public') == 'public'; }
    function eventParticipant(data) {
      return signed() && request.auth.uid in data.get('participantIds', data.participants.keys());
    }
    function eventReadable(data) {
      return admin() || owner(data.ownerId) || eventParticipant(data) || runtimeOpen() && eventPublic(data);
    }
    function eventListReadable(data) {
      // A direct get can keep legacy public documents readable. List queries must
      // prove an explicit public/owner/participant filter; a default value would
      // incorrectly authorize an unrestricted directory query.
      return admin() || owner(data.ownerId) || signed() && request.auth.uid in data.participantIds
        || runtimeOpen() && data.visibility == 'public';
    }
    function relatedEventReadable(id) {
      return exists(/databases/$(database)/documents/communityEvents/$(id))
        && eventReadable(get(/databases/$(database)/documents/communityEvents/$(id)).data);
    }
    function freshInvitationState(data) {
      return data.status == 'active' && data.ownerId != request.auth.uid
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.createdAt + duration.value(10, 'm') > request.time && notBlocked(data.ownerId);
    }
    function freshInvitation(data) { return verifiedActor() && freshInvitationState(data); }
    function validInvitation(data, id) {
      return id.matches('[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{16}')
        && data.keys().hasAll(['id', 'ownerId', 'kind', 'eventId', 'status', 'createdAt', 'usedBy', 'usedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'kind', 'eventId', 'status', 'createdAt', 'usedBy', 'usedAt'])
        && data.id == id && text(data.ownerId, 1, 128) && data.kind in ['connection', 'event']
        && data.status in ['active', 'used', 'revoked'] && data.createdAt is timestamp
        && text(data.eventId, 0, 128) && text(data.usedBy, 0, 128)
        && (data.usedAt == '' || data.usedAt is timestamp)
        && (data.kind == 'connection' && data.eventId == '' || data.kind == 'event' && data.eventId != '');
    }
    function consumedInvitation(code, kind, eventId) {
      let before = get(/databases/$(database)/documents/communityInvitations/$(code)).data;
      let after = getAfter(/databases/$(database)/documents/communityInvitations/$(code)).data;
      // Connections establish verifiedActor directly. Event admission callers
      // prove absent -> present membership, whose event rule establishes it.
      return freshInvitationState(before) && before.kind == kind && before.eventId == eventId
        && after.status == 'used' && after.usedBy == request.auth.uid && after.usedAt == request.time;
    }
    function validConnection(data, ownerUid, peerUid) {
      return data.keys().hasAll(['ownerId', 'peerId', 'inviteId', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'peerId', 'inviteId', 'createdAt'])
        && data.ownerId == ownerUid && data.peerId == peerUid && ownerUid != peerUid
        && text(ownerUid, 1, 128) && text(peerUid, 1, 128)
        && text(data.inviteId, 16, 16) && data.createdAt == request.time;
    }
    function connectionPair(code, inviter) {
      let recipient = request.auth.uid;
      let first = getAfter(/databases/$(database)/documents/communityConnections/$(inviter)/members/$(recipient)).data;
      let second = getAfter(/databases/$(database)/documents/communityConnections/$(recipient)/members/$(inviter)).data;
      return !exists(/databases/$(database)/documents/communityConnections/$(inviter)/members/$(recipient))
        && !exists(/databases/$(database)/documents/communityConnections/$(recipient)/members/$(inviter))
        && validConnection(first, inviter, recipient) && validConnection(second, recipient, inviter)
        && first.inviteId == code && second.inviteId == code;
    }
    function connectionMirror(data, ownerUid, peerUid) {
      let mirror = getAfter(/databases/$(database)/documents/communityConnections/$(peerUid)/members/$(ownerUid)).data;
      return validConnection(mirror, peerUid, ownerUid) && mirror.inviteId == data.inviteId;
    }
    function validAdmission(data, eventId, uid) {
      return data.keys().hasAll(['eventId', 'userId', 'inviteId', 'createdAt'])
        && data.keys().hasOnly(['eventId', 'userId', 'inviteId', 'createdAt'])
        && data.eventId == eventId && data.userId == uid && text(data.inviteId, 16, 16)
        && data.createdAt == request.time;
    }
    function admissionPair(code, eventId, inviter) {
      let before = get(/databases/$(database)/documents/communityEvents/$(eventId)).data;
      let after = getAfter(/databases/$(database)/documents/communityEvents/$(eventId)).data;
      let receipt = getAfter(/databases/$(database)/documents/communityEventAdmissions/$(eventId)/members/$(request.auth.uid)).data;
      return before.get('visibility', 'public') == 'private' && before.ownerId == inviter
        && !(request.auth.uid in before.participants) && request.auth.uid in after.participants
        && validAdmission(receipt, eventId, request.auth.uid) && receipt.inviteId == code;
    }
    function privateAdmission(eventId) {
      let receipt = getAfter(/databases/$(database)/documents/communityEventAdmissions/$(eventId)/members/$(request.auth.uid)).data;
      return request.auth.token.get('email_verified', false) == true && validAdmission(receipt, eventId, request.auth.uid)
        && consumedInvitation(receipt.inviteId, 'event', eventId)
        && getAfter(/databases/$(database)/documents/communityInvitations/$(receipt.inviteId)).data.ownerId == resource.data.ownerId;
    }
    match /communityInvitations/{code} {
      // No public lookup or listing. A recipient must know the exact random code.
      allow get: if owner(resource.data.ownerId) || admin()
        || freshInvitation(resource.data)
        || verifiedActor() && resource.data.status == 'used' && owner(resource.data.usedBy);
      allow list: if owner(resource.data.ownerId) || admin();
      allow create: if active() && validInvitation(request.resource.data, code)
        && request.resource.data.ownerId == request.auth.uid && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time && request.resource.data.usedBy == '' && request.resource.data.usedAt == ''
        && (request.resource.data.kind == 'connection'
          || owner(get(/databases/$(database)/documents/communityEvents/$(request.resource.data.eventId)).data.ownerId)
            && get(/databases/$(database)/documents/communityEvents/$(request.resource.data.eventId)).data.get('visibility', 'public') == 'private');
      allow update: if validInvitation(request.resource.data, code)
        && (owner(resource.data.ownerId) && resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'revoked'
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedBy', 'usedAt'])
            && request.resource.data.status == 'used' && request.resource.data.usedBy == request.auth.uid && request.resource.data.usedAt == request.time
            && (resource.data.kind == 'connection' && freshInvitation(resource.data) && connectionPair(code, resource.data.ownerId)
              // A private event admission must change absent -> present for this
              // actor. Its event rule establishes verifiedActor exactly once;
              // this branch still validates code freshness, blocks and receipt.
              || resource.data.kind == 'event' && freshInvitationState(resource.data)
                && admissionPair(code, resource.data.eventId, resource.data.ownerId)));
      allow delete: if false;
    }
    match /communityConnections/{ownerUid}/members/{peerUid} {
      allow get: if owner(ownerUid) || owner(peerUid) || admin();
      allow list: if owner(ownerUid) || admin();
      allow create: if verifiedActor() && validConnection(request.resource.data, ownerUid, peerUid)
        && (request.auth.uid == ownerUid || request.auth.uid == peerUid)
        && consumedInvitation(request.resource.data.inviteId, 'connection', '')
        && getAfter(/databases/$(database)/documents/communityInvitations/$(request.resource.data.inviteId)).data.ownerId in [ownerUid, peerUid]
        && connectionMirror(request.resource.data, ownerUid, peerUid);
      allow update: if false;
      // Either participant can withdraw the entire mirrored relationship while paused.
      allow delete: if (owner(ownerUid) || owner(peerUid))
        && !existsAfter(/databases/$(database)/documents/communityConnections/$(peerUid)/members/$(ownerUid));
    }
    match /communityEventAdmissions/{eventId}/members/{uid} {
      allow get: if owner(uid) || admin()
        || owner(get(/databases/$(database)/documents/communityEvents/$(eventId)).data.ownerId);
      allow list: if admin() || owner(get(/databases/$(database)/documents/communityEvents/$(eventId)).data.ownerId);
      // admissionPair requires a real new event membership in this same atomic
      // operation, whose event rule enforces age/terms/runtime/email/suspension.
      allow create, update: if owner(uid) && validAdmission(request.resource.data, eventId, uid)
        && consumedInvitation(request.resource.data.inviteId, 'event', eventId)
        && admissionPair(request.resource.data.inviteId, eventId,
          getAfter(/databases/$(database)/documents/communityInvitations/$(request.resource.data.inviteId)).data.ownerId);
      allow delete: if owner(uid) || admin();
    }
    function validProfile(data, uid) {
      return data.keys().hasAll(['id', 'name', 'bio', 'city', 'country', 'position', 'team', 'level',
          'adultConfirmed', 'verification', 'entityType', 'createdAt', 'acceptedTermsVersion', 'acceptedTermsAt'])
        && data.keys().hasOnly(['id', 'name', 'bio', 'city', 'country', 'position', 'team', 'level',
          'adultConfirmed', 'verification', 'entityType', 'createdAt', 'acceptedTermsVersion', 'acceptedTermsAt'])
        && data.id == uid && text(data.name, 1, 100) && text(data.bio, 0, 1000)
        && text(data.city, 0, 100) && text(data.country, 0, 100) && text(data.position, 0, 100)
        && text(data.team, 0, 100) && data.level in ['amateur', 'professional']
        && data.adultConfirmed is bool && data.verification in ['unverified', 'verified']
        && data.entityType in ['individual', 'group', 'club'] && date(data.createdAt)
        && data.acceptedTermsVersion in ['', '2026-10-05', '2026-10-06'] && (data.acceptedTermsAt == '' || date(data.acceptedTermsAt))
        && (data.acceptedTermsVersion == '' && data.acceptedTermsAt == ''
          || data.acceptedTermsVersion in ['2026-10-05', '2026-10-06'] && date(data.acceptedTermsAt));
    }
    function publicProjection(data, profile) {
      return data.keys().hasAll(['id', 'name', 'bio', 'city', 'country', 'position', 'team', 'level', 'verification', 'entityType', 'createdAt'])
        && data.keys().hasOnly(['id', 'name', 'bio', 'city', 'country', 'position', 'team', 'level', 'verification', 'entityType', 'createdAt', 'searchTokens'])
        && (!('searchTokens' in data) || data.searchTokens is list && data.searchTokens.size() <= 600)
        && data.id == profile.id && data.name == profile.name && data.bio == profile.bio
        && data.city == profile.city && data.country == profile.country && data.position == profile.position
        && data.team == profile.team && data.level == profile.level && data.verification == profile.verification
        && data.entityType == profile.entityType && data.createdAt == profile.createdAt;
    }
    function completedProfile(profile) {
      return profile.adultConfirmed == true && profile.acceptedTermsVersion == '2026-10-06' && date(profile.acceptedTermsAt) && text(profile.city, 1, 100) && text(profile.country, 1, 100);
    }
    function mirroredPublic(uid, profile) {
      return completedProfile(profile)
        ? publicProjection(getAfter(/databases/$(database)/documents/communityPublicProfiles/$(uid)).data, profile)
        : !exists(/databases/$(database)/documents/communityPublicProfiles/$(uid));
    }
    match /communityProfiles/{uid} {
      // Consent and age declarations are accessible only to the owner and administrator.
      allow read: if owner(uid) || admin();
      allow create: if owner(uid) && validProfile(request.resource.data, uid)
        && request.resource.data.createdAt == request.time && request.resource.data.verification == 'unverified' && mirroredPublic(uid, request.resource.data);
      allow update: if request.resource.data.createdAt == resource.data.createdAt && validProfile(request.resource.data, uid) && mirroredPublic(uid, request.resource.data) && (
        owner(uid) && (request.resource.data.acceptedTermsAt == resource.data.acceptedTermsAt || request.resource.data.acceptedTermsAt == request.time || request.resource.data.acceptedTermsVersion == '' && request.resource.data.acceptedTermsAt == '') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['name', 'bio', 'city', 'country', 'position', 'team', 'level', 'adultConfirmed', 'entityType',
           'acceptedTermsVersion', 'acceptedTermsAt'])
        || admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verification'])
          && (request.resource.data.verification == 'unverified'
            || getAfter(/databases/$(database)/documents/communityVerifications/$(uid)).data.status == 'approved')
      );
      allow delete: if false;
    }
    match /communityPublicProfiles/{uid} {
      allow read: if runtimeOpen();
      allow create, update: if (owner(uid) || admin())
        && completedProfile(getAfter(/databases/$(database)/documents/communityProfiles/$(uid)).data)
        && publicProjection(request.resource.data, getAfter(/databases/$(database)/documents/communityProfiles/$(uid)).data);
      allow delete: if false;
    }
    match /communityFollows/{id} {
      // Sporting relationships are public; the collection stores no contact or consent data.
      allow read: if runtimeOpen() || owner(resource.data.followerId);
      allow create: if active() && request.resource.data.keys().hasAll(['followerId', 'followingId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['followerId', 'followingId', 'createdAt'])
        && request.resource.data.followerId == request.auth.uid
        && text(request.resource.data.followingId, 1, 128)
        && request.resource.data.followingId != request.auth.uid && notBlocked(request.resource.data.followingId)
        && id == request.auth.uid + '_' + request.resource.data.followingId
        && exists(/databases/$(database)/documents/communityPublicProfiles/$(request.resource.data.followingId))
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if owner(resource.data.followerId);
    }
    function validEvent(data, id) {
      return data.keys().hasAll(['id', 'ownerId', 'ownerName', 'title', 'type', 'format', 'level', 'city', 'country', 'timeZone', 'venue', 'startAt', 'startAtMs', 'capacity', 'entry', 'description', 'status', 'tournamentFormat', 'participants', 'fixtures', 'createdAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'ownerName', 'title', 'type', 'format', 'level', 'city', 'country', 'timeZone', 'venue', 'startAt', 'startAtMs', 'capacity', 'entry', 'description', 'status', 'tournamentFormat', 'participants', 'participantIds', 'fixtures', 'fixtureIds', 'createdAt', 'updatedAt', 'revision', 'history', 'rsvps', 'waitlist', 'waitlistOrder', 'result', 'teamId', 'visibility'])
        && data.id == id && text(data.ownerId, 1, 128) && text(data.ownerName, 1, 100)
        && text(data.title, 1, 100) && data.type in ['match', 'tournament'] && data.format in ['5', '7', '11']
        && data.level in ['amateur', 'professional'] && text(data.city, 1, 100) && text(data.country, 1, 100)
        && text(data.timeZone, 1, 100) && text(data.venue, 1, 200) && iso(data.startAt)
        && data.startAtMs is int && data.capacity is int && data.capacity >= 2 && data.capacity <= 64
        && (data.type != 'tournament' || data.capacity <= 32) && data.entry in ['players', 'teams'] && text(data.description, 0, 2000)
        && data.status in ['open', 'closed', 'cancelled', 'completed'] && data.tournamentFormat in ['league', 'knockout']
        && data.participants is map && data.participants.size() <= data.capacity
        && data.get('participantIds', data.participants.keys()) is list
        && data.get('participantIds', data.participants.keys()).toSet() == data.participants.keys().toSet()
        && data.get('participantIds', data.participants.keys()).size() == data.participants.size()
        && data.get('visibility', 'public') in ['public', 'private']
        && data.fixtures is list && data.fixtures.size() <= 496 && date(data.createdAt)
        && data.get('fixtureIds', []) is list && data.get('fixtureIds', []).size() <= 496 && data.get('fixtureIds', []).size() == data.get('fixtureIds', []).toSet().size()
        && data.get('rsvps', {}) is map && data.get('rsvps', {}).size() <= 128
        && data.get('waitlist', {}) is map && data.get('waitlist', {}).size() <= 64
        && data.get('waitlistOrder', []) is list && data.get('waitlistOrder', []).size() == data.get('waitlist', {}).size()
        && data.get('waitlistOrder', []).toSet() == data.get('waitlist', {}).keys().toSet()
        && data.get('revision', 0) is int && data.get('revision', 0) >= 0
        && data.get('history', []) is list && data.get('history', []).size() <= 50
        && (!('teamId' in data) || data.teamId == '' || text(data.teamId, 1, 128))
        && (!('result' in data) || data.type == 'match' && data.status == 'completed'
          && data.result.keys().hasAll(['homeName', 'awayName', 'homeScore', 'awayScore'])
          && data.result.keys().hasOnly(['homeName', 'awayName', 'homeScore', 'awayScore'])
          && text(data.result.homeName, 1, 100) && text(data.result.awayName, 1, 100) && data.result.homeName != data.result.awayName
          && data.result.homeScore is int && data.result.homeScore >= 0 && data.result.homeScore <= 99
          && data.result.awayScore is int && data.result.awayScore >= 0 && data.result.awayScore <= 99);
    }
    function validEventState(data) {
      // Cache collection projections: repeated keys()/toSet() over a full roster
      // otherwise exhaust the rules expression budget before atomic admission.
      let participants = data.participants;
      let participantKeys = participants.keys();
      let participantIds = data.get('participantIds', participantKeys);
      let fixtureIds = data.get('fixtureIds', []);
      let rsvps = data.get('rsvps', {});
      let waitlist = data.get('waitlist', {});
      let waitlistOrder = data.get('waitlistOrder', []);
      let revision = data.get('revision', 0);
      let history = data.get('history', []);
      return data.keys().hasOnly(['id', 'ownerId', 'ownerName', 'title', 'type', 'format', 'level', 'city', 'country', 'timeZone', 'venue', 'startAt', 'startAtMs', 'capacity', 'entry', 'description', 'status', 'tournamentFormat', 'participants', 'participantIds', 'fixtures', 'fixtureIds', 'createdAt', 'updatedAt', 'revision', 'history', 'rsvps', 'waitlist', 'waitlistOrder', 'result', 'teamId', 'visibility'])
        && data.capacity is int && data.capacity >= 2 && data.capacity <= 64 && (data.type != 'tournament' || data.capacity <= 32)
        && data.status in ['open', 'closed', 'cancelled', 'completed']
        && participants is map && participantKeys.size() <= data.capacity
        && participantIds is list && participantIds.toSet() == participantKeys.toSet() && participantIds.size() == participantKeys.size()
        && data.get('visibility', 'public') in ['public', 'private']
        && data.fixtures is list && data.fixtures.size() <= 496 && date(data.createdAt)
        && fixtureIds is list && fixtureIds.size() <= 496 && fixtureIds.size() == fixtureIds.toSet().size()
        && rsvps is map && rsvps.size() <= 128 && waitlist is map && waitlist.size() <= 64
        && waitlistOrder is list && waitlistOrder.size() == waitlist.size() && waitlistOrder.toSet() == waitlist.keys().toSet()
        && revision is int && revision >= 0 && history is list && history.size() <= 50
        && (!('teamId' in data) || data.teamId == '' || text(data.teamId, 1, 128))
        && (!('result' in data) || data.type == 'match' && data.status == 'completed'
          && data.result.keys().hasAll(['homeName', 'awayName', 'homeScore', 'awayScore'])
          && data.result.keys().hasOnly(['homeName', 'awayName', 'homeScore', 'awayScore'])
          && text(data.result.homeName, 1, 100) && text(data.result.awayName, 1, 100) && data.result.homeName != data.result.awayName
          && data.result.homeScore is int && data.result.homeScore >= 0 && data.result.homeScore <= 99
          && data.result.awayScore is int && data.result.awayScore >= 0 && data.result.awayScore <= 99);
    }
    function fixtureDocument(data, docId) {
      let event = getAfter(/databases/$(database)/documents/communityEvents/$(data.eventId)).data;
      return data.keys().hasAll(['id', 'eventId', 'ownerId', 'round', 'homeId', 'awayId', 'homeScore', 'awayScore', 'kickoffAt', 'timeZone', 'venue', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'eventId', 'ownerId', 'round', 'homeId', 'awayId', 'homeScore', 'awayScore', 'kickoffAt', 'timeZone', 'venue', 'createdAt', 'updatedAt'])
        && docId == data.eventId + '_' + data.id && data.ownerId == event.ownerId
        && data.round is int && data.round >= 1 && data.round <= 64 && data.id.matches('r' + string(data.round) + '-[1-9][0-9]*')
        && data.homeId in event.participants && data.homeId != data.awayId
        && (data.awayId in event.participants || data.awayId == '' && event.tournamentFormat == 'knockout')
        && (data.homeScore == null && data.awayScore == null
          || data.awayId != '' && data.homeScore is int && data.awayScore is int && data.homeScore >= 0 && data.homeScore <= 99 && data.awayScore >= 0 && data.awayScore <= 99
            && (event.tournamentFormat != 'knockout' || data.homeScore != data.awayScore))
        && (data.kickoffAt == null || data.kickoffAt is timestamp)
        && text(data.timeZone, 1, 100) && text(data.venue, 1, 200) && date(data.createdAt) && date(data.updatedAt)
        && event.updatedAt == request.time && event.get('revision', 0) == get(/databases/$(database)/documents/communityEvents/$(data.eventId)).data.get('revision', 0) + 1
        && data.id in event.get('fixtureIds', []) && event.type == 'tournament' && event.status in ['closed', 'completed'];
    }
    match /communityFixtures/{docId} {
      allow read: if relatedEventReadable(resource.data.eventId);
      allow create: if active() && fixtureDocument(request.resource.data, docId) && owner(request.resource.data.ownerId)
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if active() && owner(resource.data.ownerId) && fixtureDocument(request.resource.data, docId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['homeScore', 'awayScore', 'kickoffAt', 'timeZone', 'venue', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && get(/databases/$(database)/documents/communityEvents/$(resource.data.eventId)).data.status == 'closed'
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['kickoffAt', 'timeZone', 'venue'])
          || resource.data.homeScore == null && request.resource.data.kickoffAt is timestamp && request.resource.data.kickoffAt > request.time)
        && (get(/databases/$(database)/documents/communityEvents/$(resource.data.eventId)).data.tournamentFormat != 'knockout'
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['homeScore', 'awayScore'])
          || !exists(/databases/$(database)/documents/communityFixtures/$(resource.data.eventId + '_r' + string(resource.data.round + 1) + '-1')));
      allow delete: if false;
    }

    function unchangedWaitlist() {
      return request.resource.data.get('waitlist', {}) == resource.data.get('waitlist', {})
        && request.resource.data.get('waitlistOrder', []) == resource.data.get('waitlistOrder', []);
    }
    function promotesFirst() {
      let before = resource.data.get('waitlist', {});
      let order = resource.data.get('waitlistOrder', []);
      let after = request.resource.data.get('waitlist', {});
      let added = request.resource.data.participants.keys().removeAll(resource.data.participants.keys());
      return order.size() > 0 && added.size() == 1 && added[0] == order[0]
        && request.resource.data.participants[order[0]] == before[order[0]].name
        && after.diff(before).affectedKeys().hasOnly([order[0]]) && !(order[0] in after)
        && request.resource.data.get('waitlistOrder', []) == order.removeAll([order[0]]);
    }
    function selfParticipation() {
