{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lacantera-push",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "FIREBASE_PROJECT_ID": "gen-lang-client-0853130215",
