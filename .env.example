# Firebase: se utiliza firebase-applet-config.json si no se establece VITE_FIREBASE_API_KEY.
# Esta configuración es pública. Nunca colocar claves privadas o credenciales Admin aquí.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# Datos públicos del responsable; completar antes de abrir el registro.
VITE_OPERATOR_NAME=
VITE_CONTACT_EMAIL=
VITE_OPERATOR_COUNTRY=

# build:hosting establece firebase; las vistas Vercel conservan su proveedor.
VITE_HOSTING_PROVIDER=vercel

# Mantener false para usuarios reales. En desarrollo local existe un entorno separado.
VITE_ENABLE_DEMO=false

# Activar sólo tras financiar y comprobar Storage y la función de limpieza.
# El entorno demo permite fotos/vídeos locales sin esta variable.
VITE_ENABLE_MEDIA_UPLOADS=false

# Abrir sólo tras pasar check:release, acta de nube y runtime abierto por el administrador.
VITE_SERVICE_OPEN=false
# Piloto privado: sólo cuentas Google verificadas incluidas en runtime.pilotUserIds.
# Exige SERVICE_OPEN=false, demo=false y medios=false; no acredita apertura pública.
VITE_ENABLE_PILOT=false
