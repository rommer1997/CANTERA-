rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signed() { return request.auth != null; }
    function owner(uid) { return signed() && request.auth.uid == uid; }
    function admin() { return signed() && request.auth.token.get('admin', false) == true; }
    match /community/{uid}/{fileName} {
      // Published media is public. Download-token URLs also remain public to their holders.
      allow get: if true;
      allow list: if false;
      // Uploads are closed on the server while sponsorship is pending.
      // Named Firestore cannot be consulted by Storage rules: a client feature
      // flag cannot authorize consent, quotas or inspected uploads safely.
      allow create: if false;
      allow update: if false;
      allow delete: if owner(uid) || admin();
    }
    match /{path=**} { allow read, write: if false; }
  }
}
