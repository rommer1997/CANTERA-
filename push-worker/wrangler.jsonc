  },
  "d1_databases": [{ "binding": "DB", "database_name": "lacantera-push", "database_id": "REPLACE_AFTER_DATABASE_CREATION", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["* * * * *"] }
}
