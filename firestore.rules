        && request.resource.data.status == 'open' && request.resource.data.createdAt == request.time;
      allow update: if admin() && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'resolved';
      allow delete: if false;
    }
    match /communityConfiguration/{id} {
      allow read: if id == 'runtime' || admin();
      allow create, update: if admin() && id == 'runtime'
        && request.resource.data.keys().hasAll(['serviceStatus', 'mediaUploadsEnabled', 'contactEmail', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['serviceStatus', 'mediaUploadsEnabled', 'contactEmail', 'updatedAt'])
        && request.resource.data.serviceStatus in ['setup', 'open', 'paused'] && request.resource.data.mediaUploadsEnabled == false
        && text(request.resource.data.contactEmail, 0, 200) && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /communityBlocks/{id} {
      allow read: if owner(resource.data.ownerId);
      allow create: if signed() && request.resource.data.keys().hasAll(['ownerId', 'blockedId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['ownerId', 'blockedId', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid && text(request.resource.data.blockedId, 1, 128)
        && request.resource.data.blockedId != request.auth.uid && id == request.auth.uid + '_' + request.resource.data.blockedId
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if owner(resource.data.ownerId);
    }
    function notBlocked(uid) {
      return !exists(/databases/$(database)/documents/communityBlocks/$(request.auth.uid + '_' + uid))
        && !exists(/databases/$(database)/documents/communityBlocks/$(uid + '_' + request.auth.uid));
    }
    function interactionAllowed(postId) {
      return hasPost(postId) && notBlocked(get(/databases/$(database)/documents/communityPosts/$(postId)).data.authorId);
    }
    match /communityAccountModeration/{uid} {
      allow read: if owner(uid) || admin();
      allow create, update: if admin() && request.resource.data.keys().hasAll(['status', 'reason', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['status', 'reason', 'updatedAt'])
        && request.resource.data.status in ['active', 'suspended'] && text(request.resource.data.reason, 1, 1000)
        && request.resource.data.updatedAt == request.time;
      allow delete: if admin();
    }
    match /communityRightsRequests/{id} {
      allow read: if owner(resource.data.userId) || admin();
      allow create: if signed() && request.resource.data.userId == request.auth.uid && rightsData(request.resource.data, id)
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time && request.resource.data.reviewedAt == '';
      allow update: if rightsData(request.resource.data, id) && (
        owner(resource.data.userId) && resource.data.status in ['completed', 'rejected'] && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time && request.resource.data.reviewedAt == ''
          && request.resource.data.userId == resource.data.userId && request.resource.data.kind == resource.data.kind
        || admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt'])
          && request.resource.data.status in ['processing', 'completed', 'rejected'] && request.resource.data.reviewedAt == request.time);
      allow delete: if false;
    }
    function rightsData(data, id) {
      return data.keys().hasAll(['id', 'userId', 'kind', 'status', 'createdAt', 'reviewedAt'])
        && data.keys().hasOnly(['id', 'userId', 'kind', 'status', 'createdAt', 'reviewedAt'])
        && data.id == id && text(data.userId, 1, 128) && data.kind in ['export', 'delete'] && id == data.userId + '_' + data.kind
        && data.status in ['pending', 'processing', 'completed', 'rejected'] && date(data.createdAt)
        && (data.reviewedAt == '' || date(data.reviewedAt));
    }
    function teamRecord(teamId) { return get(/databases/$(database)/documents/communityTeams/$(teamId)).data; }
    function teamMembership(teamId) { return get(/databases/$(database)/documents/communityTeamMembers/$(teamId + '_' + request.auth.uid)).data; }
    function teamMember(teamId) { return signed() && exists(/databases/$(database)/documents/communityTeamMembers/$(teamId + '_' + request.auth.uid)); }
    function teamManager(teamId) { return teamMember(teamId) && teamMembership(teamId).role in ['owner', 'manager']; }
    function teamOwner(teamId) { return signed() && teamRecord(teamId).ownerId == request.auth.uid; }
    function validTeam(data, id) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'country', 'city', 'description', 'level', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'name', 'country', 'city', 'description', 'level', 'status', 'createdAt', 'updatedAt'])
        && data.id == id && text(data.ownerId, 1, 128) && text(data.name, 1, 100) && text(data.country, 1, 100) && text(data.city, 1, 100)
        && text(data.description, 0, 2000) && data.level in ['amateur', 'professional'] && data.status in ['active', 'archived'] && date(data.createdAt) && date(data.updatedAt);
    }
    match /communityTeams/{id} {
      allow get: if runtimeOpen() || teamMember(id) || admin();
      allow list: if runtimeOpen();
      allow create: if active() && validTeam(request.resource.data, id) && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'active' && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/communityTeamMembers/$(id + '_' + request.auth.uid)).data.role == 'owner';
      allow update: if active() && owner(resource.data.ownerId) && validTeam(request.resource.data, id)
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time
        && (request.resource.data.ownerId == resource.data.ownerId
          || getAfter(/databases/$(database)/documents/communityTeamMembers/$(id + '_' + resource.data.ownerId)).data.role == 'manager'
            && getAfter(/databases/$(database)/documents/communityTeamMembers/$(id + '_' + request.resource.data.ownerId)).data.role == 'owner'
            && exists(/databases/$(database)/documents/communityTeamMembers/$(id + '_' + request.resource.data.ownerId)));
      allow delete: if false;
    }
    function validTeamMember(data, id) {
      return data.keys().hasAll(['id', 'teamId', 'userId', 'name', 'role', 'joinedAt']) && data.keys().hasOnly(['id', 'teamId', 'userId', 'name', 'role', 'joinedAt'])
        && data.id == id && text(data.teamId, 1, 128) && text(data.userId, 1, 128) && id == data.teamId + '_' + data.userId
        && text(data.name, 1, 100) && data.role in ['owner', 'manager', 'member'] && date(data.joinedAt);
    }
    match /communityTeamMembers/{id} {
      allow get: if signed() && (!exists(/databases/$(database)/documents/communityTeamMembers/$(id)) || owner(resource.data.userId) || teamMember(resource.data.teamId) || admin());
      allow list: if owner(resource.data.userId) || teamMember(resource.data.teamId) || admin();
      allow create: if active() && validTeamMember(request.resource.data, id) && request.resource.data.joinedAt == request.time && (
        request.resource.data.userId == request.auth.uid && request.resource.data.name == actorProfile().name && request.resource.data.role == 'owner'
          && getAfter(/databases/$(database)/documents/communityTeams/$(request.resource.data.teamId)).data.ownerId == request.auth.uid
          && !exists(/databases/$(database)/documents/communityTeams/$(request.resource.data.teamId))
        || teamManager(request.resource.data.teamId) && teamRecord(request.resource.data.teamId).status == 'active' && request.resource.data.role == 'member'
          && getAfter(/databases/$(database)/documents/communityTeamJoinRequests/$(id)).data.status == 'approved'
          && get(/databases/$(database)/documents/communityTeamJoinRequests/$(id)).data.status == 'pending'
          && request.resource.data.name == get(/databases/$(database)/documents/communityTeamJoinRequests/$(id)).data.name);
      allow update: if active() && validTeamMember(request.resource.data, id) && teamOwner(resource.data.teamId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) && (
          resource.data.userId != request.auth.uid && request.resource.data.role in ['member', 'manager']
          || getAfter(/databases/$(database)/documents/communityTeams/$(resource.data.teamId)).data.ownerId != teamRecord(resource.data.teamId).ownerId
            && (request.resource.data.userId == getAfter(/databases/$(database)/documents/communityTeams/$(resource.data.teamId)).data.ownerId && request.resource.data.role == 'owner'
              || resource.data.userId == request.auth.uid && request.resource.data.role == 'manager'));
      allow delete: if signed() && resource.data.role != 'owner' && (owner(resource.data.userId) || active() && teamOwner(resource.data.teamId));
    }
    match /communityTeamInvites/{id} {
      allow get: if signed();
      allow list: if teamManager(resource.data.teamId);
      allow create: if active() && teamManager(request.resource.data.teamId) && teamRecord(request.resource.data.teamId).status == 'active'
        && request.resource.data.keys().hasAll(['id', 'teamId', 'createdBy', 'revoked', 'expiresAt', 'createdAt'])
        && request.resource.data.keys().hasOnly(['id', 'teamId', 'createdBy', 'revoked', 'expiresAt', 'createdAt'])
        && request.resource.data.id == id && request.resource.data.createdBy == request.auth.uid && request.resource.data.revoked == false
        && request.resource.data.createdAt == request.time && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time && request.resource.data.expiresAt <= request.time + duration.value(30, 'd');
      allow update: if active() && teamManager(resource.data.teamId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked']) && request.resource.data.revoked == true;
      allow delete: if false;
    }
    function validJoinRequest(data, id) {
      return data.keys().hasAll(['id', 'teamId', 'userId', 'name', 'inviteId', 'status', 'createdAt', 'reviewedAt'])
        && data.keys().hasOnly(['id', 'teamId', 'userId', 'name', 'inviteId', 'status', 'createdAt', 'reviewedAt'])
        && data.id == id && text(data.teamId, 1, 128) && text(data.userId, 1, 128) && id == data.teamId + '_' + data.userId
        && text(data.name, 1, 100) && text(data.inviteId, 0, 128) && data.status in ['pending', 'approved', 'rejected']
        && date(data.createdAt) && (data.reviewedAt == '' || date(data.reviewedAt));
    }
    function validInvite(data) {
      return data.inviteId == '' || get(/databases/$(database)/documents/communityTeamInvites/$(data.inviteId)).data.teamId == data.teamId
        && get(/databases/$(database)/documents/communityTeamInvites/$(data.inviteId)).data.revoked == false
        && get(/databases/$(database)/documents/communityTeamInvites/$(data.inviteId)).data.expiresAt > request.time;
    }
    match /communityTeamJoinRequests/{id} {
      allow get: if signed() && (!exists(/databases/$(database)/documents/communityTeamJoinRequests/$(id)) || owner(resource.data.userId) || teamManager(resource.data.teamId) || admin());
      allow list: if owner(resource.data.userId) || teamManager(resource.data.teamId) || admin();
      allow create: if active() && validJoinRequest(request.resource.data, id) && request.resource.data.userId == request.auth.uid
        && request.resource.data.name == actorProfile().name && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time
        && request.resource.data.reviewedAt == '' && teamRecord(request.resource.data.teamId).status == 'active'
        && !teamMember(request.resource.data.teamId) && validInvite(request.resource.data);
      allow update: if active() && validJoinRequest(request.resource.data, id) && (
        owner(resource.data.userId) && resource.data.status == 'rejected' && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time && request.resource.data.reviewedAt == '' && validInvite(request.resource.data)
          && request.resource.data.teamId == resource.data.teamId && request.resource.data.userId == resource.data.userId
        || teamManager(resource.data.teamId) && teamRecord(resource.data.teamId).status == 'active' && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt']) && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.reviewedAt == request.time && (request.resource.data.status != 'approved'
            || getAfter(/databases/$(database)/documents/communityTeamMembers/$(id)).data.role == 'member'));
      allow delete: if owner(resource.data.userId);
    }

    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create: if owner(uid) && request.resource.data.uid == uid
        && request.resource.data.role in ['PLAYER', 'GUARDIAN']
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt',
          'bio', 'location', 'height', 'weight', 'updatedAt']);
      allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
        ['displayName', 'photoURL', 'bio', 'location', 'height', 'weight', 'updatedAt']);
      allow delete: if false;
      match /likes/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['timestamp'])
          && date(request.resource.data.timestamp);
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
